#!/bin/bash
# ============================================================================
# a-stock-data API Wrapper — FC3 Custom Runtime Bootstrap (V5)
# 修复: custom.debian11 无 pip → apt-get 系统安装 python3-pip
# 策略链: apt-get → ensurepip → get-pip.py → 最终兜底
# ============================================================================

set -eo pipefail

echo "================================================"
echo "[bootstrap] a-stock-data API Wrapper Starting"
echo "[bootstrap] Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
echo "[bootstrap] Python: $(python3 --version 2>&1 || echo MISSING)"
echo "================================================"

# --------------- 多策略安装 pip ---------------
ensure_pip() {
    # 策略1: 已有 pip (极少数情况)
    python3 -m pip --version &>/dev/null && return 0

    # 策略2: apt-get 装系统级 pip (debian 系最可靠)
    echo "[bootstrap] Trying apt-get install python3-pip..."
    if apt-get update -qq 2>/dev/null && apt-get install -y -qq python3-pip 2>/dev/null; then
        python3 -m pip --version &>/dev/null && { echo "[bootstrap] pip installed via apt"; return 0; }
    fi
    echo "[bootstrap] apt-get failed or pip still missing"

    # 策略3: ensurepip 模块 (Python 自带但不一定打包)
    echo "[bootstrap] Trying ensurepip..."
    python3 -m ensurepip --upgrade 2>&1 | tail -3
    python3 -m pip --version &>/dev/null && { echo "[bootstrap] pip installed via ensurepip"; return 0; }

    # 策略4: get-pip.py 在线引导 (需外网)
    echo "[bootstrap] Trying get-pip.py..."
    if curl -sS --connect-timeout 10 https://bootstrap.pypa.io/get-pip.py | python3 2>&1 | tail -3; then
        python3 -m pip --version &>/dev/null && { echo "[bootstrap] pip installed via get-pip.py"; return 0; }
    fi

    echo "[bootstrap] FATAL: all pip install strategies failed"
    return 1
}

ensure_pip || exit 1
echo "[bootstrap] Final pip: $(python3 -m pip --version 2>&1)"

# --------------- 环境变量 ---------------
export PYTHONPATH="/tmp/packages"
export PIP_NO_CACHE_DIR="1"
echo "[bootstrap] PYTHONPATH=${PYTHONPATH}"

# --------------- 安装依赖 (保存退出码) ---------------
PIP="python3 -m pip"

echo "[bootstrap] Installing dependencies via Aliyun Mirror..."
pip_log=$(${PIP} install \
    -r requirements.txt \
    -t /tmp/packages \
    --upgrade \
    --upgrade-strategy eager \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    --no-cache-dir \
    2>&1)
pip_rc=$?
echo "${pip_log}" | tail -20

if [ $pip_rc -ne 0 ]; then
    echo "[bootstrap] Aliyun mirror failed (rc=$pip_rc), trying PyPI official..."
    echo "${pip_log}" | tail -5
    pip_log=$(${PIP} install \
        -r requirements.txt \
        -t /tmp/packages \
        --upgrade \
        --upgrade-strategy eager \
        -i https://pypi.org/simple/ \
        --trusted-host pypi.org \
        --no-cache-dir \
        2>&1)
    pip_rc=$?
    echo "${pip_log}" | tail -20
    if [ $pip_rc -ne 0 ]; then
        echo "[bootstrap] FATAL: PyPI also failed. Full output:"
        echo "${pip_log}"
        echo "=== requirements.txt ==="
        cat requirements.txt
        exit 1
    fi
fi

# --------------- 确认安装结果 ---------------
echo "[bootstrap] Packages installed (top 30):"
ls /tmp/packages 2>/dev/null | head -30 || echo "  EMPTY!"

echo "[bootstrap] Verifying imports..."
for pkg in flask requests pandas stockstats mootdx; do
    python3 -c "import ${pkg}" 2>&1 && echo "  [OK] ${pkg}" || echo "  [FAIL] ${pkg}"
done

# --------------- 启动 ---------------
echo "[bootstrap] Launching Flask on port ${PORT:-9000}..."
exec python3 app.py